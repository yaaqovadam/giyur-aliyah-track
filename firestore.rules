rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Sensitive User Profiles, WhatsApp OTPs, PassCodes & Paid Entitlements:
    //    Locked to authenticated owner / Admin SDK — prevents DevTools dumping of user PII
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /pro_entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /concierge_orders/{orderId} {
      allow read, write: if false;
    }
    match /concierge_files/{fileId} {
      allow read, write: if request.auth != null;
    }

    // 2. Analytics Telemetry Collections: Read-only allowed so /analytics/ client SDK fallback never wipes tables;
    //    all writes/deletes strictly locked to Cloud Functions Admin SDK
    match /site_analytics_daily/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /site_visitors_recent/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /site_crawlers_recent/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. 2-Phone Live Separated-Room Couples Interrogation Sync Rooms:
    match /couples_rooms/{roomId} {
      allow get, create, update: if roomId.size() >= 4;
      allow list, delete: if false;
    }
    match /cp_rooms/{roomId} {
      allow get, create, update: if roomId.size() >= 4;
      allow list, delete: if false;
    }
  }
}
