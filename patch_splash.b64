(function(){
  if(/bot|googlebot|crawler|spider|lighthouse|pagespeed|headless/i.test(navigator.userAgent||""))return;
  var d=document.createElement("div");
  d.style.cssText="position:fixed;inset:0;z-index:2147483647;background:#042454;display:flex;align-items:center;justify-content:center;overflow:hidden;transition:opacity .5s";
  d.innerHTML='<video src="/intro.mp4" autoplay muted playsinline webkit-playsinline style="width:100%;max-width:460px;height:124%;object-fit:cover"></video>';
  d.onclick=function(){d.style.opacity="0";setTimeout(function(){d.remove()},500)};
  document.body.appendChild(d);
})();
